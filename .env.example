NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://milox:change-me@localhost:5432/milox_live_copy?schema=public
WEB_ORIGIN=http://localhost:3000
PUBLIC_WEB_ORIGIN=https://milox.in
ADMIN_ORIGIN=http://localhost:3002
# Production admin: ADMIN_ORIGIN=https://admin.milox.in
# (Vercel fallback also allowlisted: https://milox-admin.vercel.app)
BOTS_ORIGIN=http://localhost:3003
# Production bots console (also hard-coded in DEFAULT_EXTRA_CORS_ORIGINS):
# BOTS_ORIGIN=https://milox-bots-manage.vercel.app
# Local copy of the database only. Never point local MILOX_ENV at production.
MILOX_ENV=local
# Keep false until the activity engine is explicitly approved.
BOTS_WORKER_ENABLED=false
# Staging/production bot mutations require true after explicit approval.
BOTS_ALLOW_MUTATIONS=false
# Target policy (local/test only; staging/production always resolve to disabled):
#   disabled          — no automatic targeting (default)
#   test_fixtures_only — E2E: only [[MILLOX_BOTS_TEST_FIXTURE]] posts/users
#   fresh_public      — recent eligible public posts / active users (no markers)
# Do not enable worker + fresh_public against ordinary milox_live_copy users.
BOTS_TARGET_POLICY=disabled
# Actual activity E2E (dedicated DB only — never milox_live_copy):
# BOTS_E2E=1
# BOTS_E2E_DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5432/milox_bots_e2e?schema=public
# BOTS_TARGET_POLICY=test_fixtures_only
# Setup: npm run test:bots-e2e:setup && npm run test:bots-e2e (with env vars set)
CORS_ORIGINS=https://milox.in,https://www.milox.in,https://admin.milox.in,https://milox-admin.vercel.app,https://milox-bots-manage.vercel.app
# Public URL browsers use for media links — must match your live API domain.
API_PUBLIC_URL=http://localhost:3001
# Production example:
# API_PUBLIC_URL=https://api.milox.in
UPLOAD_ROOT=../../uploads

# Generate strong, distinct secrets for every environment.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
CURSOR_SIGNING_SECRET=replace-with-a-different-32-byte-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=milox-api
JWT_AUDIENCE=milox-clients
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=15

# Transactional email (ZeptoMail) is configured in Admin → Settings → Email.
# Do not put API tokens here.
EMAIL_WORKER_POLL_MS=5000
FEED_SCORE_POLL_MS=300000
# Inactive account auto-suspend (default off). Prefer cron + npm run users:suspend-inactive:apply.
INACTIVE_ACCOUNT_WORKER_ENABLED=false
INACTIVE_ACCOUNT_DAYS=14
INACTIVE_ACCOUNT_POLL_MS=86400000
INTEREST_DAILY_LIMIT=20
WALLET_WELCOME_BONUS=500
REFERRAL_REWARD_POINTS=100
POST_REWARD_POINTS=5
INTEREST_SEND_COST=40

# PayPal Checkout — optional env fallback. Super-admins can also paste keys in Admin → Payments.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live
PAYPAL_WEBHOOK_ID=

CHAT_OUTBOX_POLL_MS=500
NOTIFICATION_OUTBOX_POLL_MS=500

# Firebase Cloud Messaging (push notifications)
# Local dev: path to the service account JSON downloaded from Firebase Console.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/milox-app-firebase-adminsdk-fbsvc-06c2578017.json

# WebRTC ICE (self-hosted coturn). Leave TURN_* empty for STUN-only local testing.
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:turn.milox.in:3478,turns:turn.milox.in:5349
# TURN_SECRET=replace-with-coturn-static-auth-secret
# TURN_USERNAME=
# TURN_PASSWORD=
# TURN_CREDENTIAL_TTL_SEC=86400


# Development only — accept dev-admin-bypass token (default on in dev unless false)
# ADMIN_AUTH_BYPASS=true
